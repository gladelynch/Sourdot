[Desktop Entry]
Type=Application
Name=Sourdot (dev)
GenericName=Godot Version Manager
Comment=Install, switch and launch Godot Engine versions — dev mode with hot reloading
Keywords=Godot;GodotEngine;Godot4;Godot3;engine;version;manager;gamedev;game;launcher;
# %k is this file's own path, so dev.sh is found next to it wherever the repo
# is cloned -- no absolute paths. Desktop entries can't express a relative
# Icon=, so it uses a stock theme icon.
Exec=bash -c "exec \\"\\$(dirname \\"\\$1\\")/dev.sh\\" --hold" sourdot %k
Icon=applications-development
Terminal=true
Categories=Development;IDE;
StartupWMClass=sourdot
